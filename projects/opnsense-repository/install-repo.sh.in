#!/bin/sh
# One D4n13X repository for every plugin. Run as root on OPNsense 26.7 amd64.
main() {
    set -eu
    [ "$(id -u)" = 0 ] || { echo 'Run as root.' >&2; exit 1; }
    [ "$(uname -m)" = amd64 ] || exit 1
    case "$(opnsense-version -v)" in 26.7|26.7.*|26.7_*) ;; *) echo 'Requires OPNsense 26.7.' >&2; exit 1 ;; esac
    [ "$(pkg config ABI)" = 'FreeBSD:15:amd64' ] || exit 1
    umask 077
    d4_work=$(mktemp -d /tmp/d4n13x-repo-install.XXXXXX)
    trap 'rm -rf "$d4_work"' EXIT
    trap 'exit 1' HUP INT TERM
    fetch -q -o "$d4_work/repo.pkg" 'https://d4n13x.github.io/relay-7c91/FreeBSD:15:amd64/26.7/os-d4n13x-repo-@VERSION@.pkg'
    [ "$(sha256 -q "$d4_work/repo.pkg")" = '@BOOTSTRAP_SHA256@' ] || { echo 'Bootstrap checksum mismatch; nothing changed.' >&2; exit 1; }
    mkdir "$d4_work/repos" "$d4_work/db" "$d4_work/cache"
    tar -xOf "$d4_work/repo.pkg" /usr/local/etc/pkg/repos/GameCache.conf > "$d4_work/repos/GameCache.conf"
    tar -xOf "$d4_work/repo.pkg" /usr/local/etc/pkg/keys/gamecache.pub > "$d4_work/gamecache.pub"
    openssl pkey -pubin -in "$d4_work/gamecache.pub" -outform DER > "$d4_work/key.der"
    [ "$(sha256 -q "$d4_work/key.der")" = '994304f193330956c0892ba655068253821d0c5830e8bfc8cb252e2707d6e91c' ] || exit 1
    # Authenticate the public combined catalog BEFORE changing installed sources.
    sed "s|/usr/local/etc/pkg/keys/gamecache.pub|$d4_work/gamecache.pub|g" "$d4_work/repos/GameCache.conf" > "$d4_work/repos/verified.conf"
    rm "$d4_work/repos/GameCache.conf"
    pkg -o "REPOS_DIR=$d4_work/repos" -o "PKG_DBDIR=$d4_work/db" -o "PKG_CACHEDIR=$d4_work/cache" update -f -r D4n13X
    pkg -o "REPOS_DIR=$d4_work/repos" -o "PKG_DBDIR=$d4_work/db" -o "PKG_CACHEDIR=$d4_work/cache" rquery -r D4n13X '%n' > "$d4_work/catalog"
    for d4_expected in os-d4n13x-repo os-gamecache os-hetzner-firewall-updater; do
        grep -Fx "$d4_expected" "$d4_work/catalog" >/dev/null || { echo 'Combined signed catalog incomplete; nothing changed.' >&2; exit 1; }
    done
    d4_install=1
    if pkg info -e os-d4n13x-repo; then
        d4_compare=$(pkg version -t "$(pkg query '%v' os-d4n13x-repo)" '@VERSION@')
        case "$d4_compare" in '='|'>') d4_install=0 ;; '<') ;; *) exit 1 ;; esac
    fi
    if [ "$d4_install" = 1 ]; then
        d4_backup=$(mktemp -d /root/d4n13x-repo-migration.XXXXXX)
        cp -p /conf/config.xml "$d4_backup/config.xml"
        for d4_old in os-d4n13x-repo os-hetzner-firewall-updater-repo; do
            if pkg info -e "$d4_old"; then pkg create -o "$d4_backup" "$d4_old"; fi
        done
        echo "Private migration backup: $d4_backup"
        if pkg info -e os-hetzner-firewall-updater-repo; then pkg delete -y os-hetzner-firewall-updater-repo; fi
        if ! pkg add "$d4_work/repo.pkg"; then
            echo 'Bootstrap installation failed; restoring previous package(s).' >&2
            for d4_previous in "$d4_backup"/*.pkg; do [ ! -f "$d4_previous" ] || pkg add -f "$d4_previous" || true; done
            exit 1
        fi
    fi
    pkg check -s os-d4n13x-repo
    # An upgraded owned split-feed configuration is removed by native pkg.
    if [ -f /usr/local/etc/pkg/repos/HetznerFirewallUpdater.conf ]; then
        echo 'An unmanaged legacy Hetzner source remains; inspect its ownership before removal.' >&2
        exit 1
    fi
    pkg update -f -r D4n13X
    pkg rquery -r D4n13X '%n' > "$d4_work/catalog"
    for d4_expected in os-d4n13x-repo os-gamecache os-hetzner-firewall-updater; do
        grep -Fx "$d4_expected" "$d4_work/catalog" >/dev/null || exit 1
    done
    for d4_installed in os-d4n13x-repo os-hetzner-firewall-updater; do
        if pkg info -e "$d4_installed" && [ "$(pkg query '%R' "$d4_installed")" != D4n13X ]; then
            pkg annotate -y -M "$d4_installed" repository D4n13X || pkg annotate -y -A "$d4_installed" repository D4n13X
        fi
    done
    echo 'D4n13X is ready: one signed repository for all plugins. Plugin settings are preserved.'
}
main "$@"
